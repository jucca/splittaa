{
  "name": "splitwise-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "npx convex deploy --cmd 'npm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "lint": "eslint app components lib hooks middleware.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:layers": "depcruise --config .dependency-cruiser.cjs app components lib hooks",
    "check:schema-doc": "node scripts/generate-schema-doc.mjs --check",
    "generate:schema-doc": "node scripts/generate-schema-doc.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "typecheck:convex": "cd convex && tsc --noEmit",
    "verify": "npm run lint && npm run check:i18n && npm run check:docs && npm run check:schema-doc && npm run check:layers && npm run typecheck && npm run typecheck:convex && npm run test:unit && npm run test:convex"
  },
  "dependencies": {
    "@clerk/backend": "^1.26.0",
    "@clerk/nextjs": "^6.13.0",
    "@clerk/themes": "^2.2.27",
    "@clerk/ui": "^1.14.0",
    "@google/generative-ai": "^0.24.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.23.0",
    "date-fns": "^4.1.0",
    "inngest": "^3.35.0",
    "lucide-react": "^0.487.0",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-spinners": "^0.15.0",
    "recharts": "^2.15.2",
    "resend": "^4.3.0",
    "sonner": "^2.0.3",
    "svix": "^1.63.1",
    "tailwind-merge": "^3.1.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "convex-test": "^0.0.53",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
